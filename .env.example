# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER expose these to the browser.
# See docs/email-delivery.md for setup steps.
# ---------------------------------------------------------------------------

# Resend API key (server-only). Get it at https://resend.com/api-keys
RESEND_API_KEY=

# Default recipient for club enquiries. The server falls back to
# darapuspitanurani@gmail.com when this is empty, and the browser can never
# override it.
REGISTRATION_TO_EMAIL=darapuspitanurani@gmail.com

# Sender address. Must belong to a domain verified in Resend.
# Example: Lacrosse Victoria Enquiries <enquiries@yourdomain.com>
EMAIL_FROM=
